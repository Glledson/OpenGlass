# ---------------------------------------------------------------------------
# OpenGlass — configuração do site (template de instalação)
# ---------------------------------------------------------------------------
# O install.sh copia este arquivo para /etc/openglass/openglass.yaml e
# substitui os marcadores abaixo com as respostas do assistente:
#   ASN          -> primary_asn
#   ORG_NAME     -> org_name
#   SITE_TITLE   -> site_title
#   NOC_EMAIL    -> email de contato exibido no menu "Contato"
debug: false
developer_mode: false

org_name: ORG_NAME
primary_asn: ASN
site_title: SITE_TITLE
site_description: "{org_name} Network Open Glass"
site_keywords: [openglass, Open glass, routing, bgp]

# Timeout (segundos) de uma requisição de consulta completa.
request_timeout: 30

# Endereço/porta em que o serviço web sobe (ajuste conforme o ambiente).
# 0.0.0.0 expõe na rede; 127.0.0.1 mantém só acesso local.
listen_address: "0.0.0.0"
listen_port: 8000

# ---------------------------------------------------------------------------
# Cache de respostas — (FUTURO)
# ---------------------------------------------------------------------------
cache:
  database: 0
  host: localhost
  port: 6379
  show_text: true
  timeout: 120

# ---------------------------------------------------------------------------
# Mensagens exibidas ao usuário — (FUTURO)
# ---------------------------------------------------------------------------
messages:
  acl_denied: "{target} is a member of {denied_network}, which is not allowed."
  acl_not_allowed: "{target} is not allowed."
  authentication_error: Authentication error occurred.
  connection_error: "Error connecting to {device_name}: {error}"
  feature_not_enabled: "{feature} is not enabled for {device_name}."
  general: Something went wrong.
  invalid_field: "{input} is an invalid {field}."
  invalid_input: "{target} is not a valid {query_type} target."
  no_input: "{field} must be specified."
  no_output: The query completed, but no matching results were found.
  no_response: No response.
  parsing_error: An error occurred while parsing the query output.
  request_timeout: Request timed out.
  vrf_not_associated: VRF {vrf_name} is not associated with {device_name}.
  vrf_not_found: VRF {vrf_name} is not defined.

# ---------------------------------------------------------------------------
# Logging (FUTURO)
# ---------------------------------------------------------------------------
logging:
  directory: /var/log
  format: text
  max_size: "50 MB"

# ---------------------------------------------------------------------------
# Consultas habilitadas
# ---------------------------------------------------------------------------
queries:
  bgp_route:
    display_name: BGP Route
    enable: true

  bgp_community:
    display_name: BGP Community
    enable: false
    mode: select

  bgp_aspath:
    display_name: BGP AS Path
    enable: false

  ping:
    display_name: Ping
    enable: true

  traceroute:
    display_name: Traceroute
    enable: true

# ---------------------------------------------------------------------------
# Saída estruturada (FUTURO)
# ---------------------------------------------------------------------------
structured:
  rpki:
    mode: external

# ---------------------------------------------------------------------------
# UI / website (FUTURO)
# ---------------------------------------------------------------------------
web:
  links:
    - title: PeeringDB
      url: "https://www.peeringdb.com/asn/ASN"
      side: left
      order: 1
    - title: RADb
      url: "https://www.radb.net/query?advanced_query=&keywords=ASASN"
      side: left
      order: 2
    - title: IRR Explorer
      url: "https://irrexplorer.nlnog.net/asn/ASASN"
      side: left
      order: 3

  menus:
    - title: Contato
      content: "Please contact [NOC_EMAIL](mailto:NOC_EMAIL) to get support."
      side: right

  logo:
    dark: static/images/openglass.png
    light: static/images/openglass.png
    favicon: static/images/openglass-icon.png
    height: null
    width: 100%
  text:
    cache_icon: Cached from {time} UTC
    cache_prefix: "Results cached for "
    complete_time: Completed in {seconds}
    fqdn_error: Unable to resolve {fqdn}
    fqdn_error_button: Try Again
    fqdn_message: Your browser has resolved {fqdn} to
    fqdn_tooltip: Use {protocol}
    no_communities: No Communities
    query_location: Location
    query_target: Target
    query_type: Query Type
    query_vrf: Routing Table
    rpki_invalid: Invalid
    rpki_unknown: No ROAs Exist
    rpki_unverified: Not Verified
    rpki_valid: Valid
    subtitle: OpenGlass Network Diagnostics
    title: openglass
    title_mode: logo_subtitle

  theme:
    default: default
    show_toggle: true
    colors:
      primary: "#38bdf8"
      secondary: "#0f172a"
      text: "#e2e8f0"
      background: "#0f172a"