# Copie para devices.yaml e preencha com seus roteadores.
# devices.yaml NÃO deve ser versionado (contém credenciais).
#
# Formato compatível com hyperglass (https://hyperglass.dev/docs/adding-devices).
# Campos ativos nesta fase: address, credential, port, nos.
# network e vrfs são ARMazenados para a fase futura de parsing/filtro (ainda
# não usados pela engine de comandos).
#
# Credenciais podem vir de variáveis de ambiente via ${VAR}:
#   password: ${ROUTER_PASSWORD}
#
# Autenticação por senha OU por chave SSH (credential.key_path).

routers:
  - name: edge-r1
    address: 192.168.1.1
    network:
      name: as12345
      display_name: AS12345
    credential:
      username: lookingglass
      password: "${ROUTER_PASSWORD}"
    port: 22
    nos: cisco_ios
    vrfs:
      - name: global
        default: true
        ipv4:
          source_address: 200.200.200.200
          access_list:
            - network: 0.0.0.0/0
              action: permit
              ge: 8
              le: 32
        ipv6:
          source_address: 2000:2000:1::1
          access_list:
            - network: ::/0
              action: permit
              ge: 32
              le: 128

  - name: edge-r2
    address: 192.168.1.2
    credential:
      username: netop
      key_path: ~/.ssh/id_rsa
    port: 22
    nos: cisco_ios